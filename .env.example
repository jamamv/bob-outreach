# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=

# About you. Optional: set these so the CLI stops asking (the web page has its own fields).
SENDER_NAME=
SENDER_COMPANY=
# What you sell, in one or two sentences, in your own words
SENDER_OFFER=
# Optional: a real result or customer the email may mention
SENDER_PROOF=

# Optional company lookup. POST {"name": "<company>"} -> JSON facts (see README "Company lookup").
# Leave empty to write every email from your description alone.
HELPER_URL=
HELPER_BUDGET_MS=20000

# Everything below is optional; these are the defaults.

# Model routing: emails with trusted lookup data vs all other emails
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
OPENAI_LIGHT_MODEL=gpt-5.4-mini
OPENAI_LIGHT_REASONING_EFFORT=none
MAX_REPAIRS=2

# One JSON line per run / per feedback ("off" to disable, "console" to print)
RUN_LOG=runs.jsonl
FEEDBACK_LOG=feedback.jsonl

# Web UI
PORT=3000
# Require this code on the web API (recommended for any public deploy)
ACCESS_CODE=
