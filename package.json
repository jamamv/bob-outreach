{
  "name": "bob-outreach",
  "version": "1.0.0",
  "description": "Bob writes personalised cold outreach emails with OpenAI, optionally tailored by a company lookup, and checked against hard writing rules",
  "type": "module",
  "bin": {
    "bob": "./bin/bob.js"
  },
  "scripts": {
    "start": "node bin/bob.js",
    "test": "node --test test/*.test.js",
    "eval": "node scripts/eval.js",
    "web": "node src/web/server.js",
    "compare": "node scripts/compare.js",
    "feedback": "node scripts/feedback-report.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "openai",
    "outreach",
    "cold-email",
    "sales"
  ],
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.8",
    "openai": "^7.36.0"
  }
}
